{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Agentchengfeng/chengfeng-videocut/blob/v0.5.9/installer/runtime-install-manifest.schema.json",
  "title": "Chengfeng VideoCut Runtime install manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "productVersion", "releaseTag", "distributionMode", "runtime", "platforms", "licenseStatus"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "chengfeng-videocut" },
    "productVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "releaseTag": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "distributionMode": { "enum": ["release-ready", "public-beta", "local-test-only"] },
    "runtime": { "$ref": "#/$defs/archive" },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "darwin-arm64": { "$ref": "#/$defs/platform" },
        "darwin-x64": { "$ref": "#/$defs/platform" },
        "win32-x64": { "$ref": "#/$defs/platform" }
      }
    },
    "licenseStatus": { "enum": ["VERIFIED", "UNVERIFIED"] },
    "licenseNote": { "type": "string", "minLength": 1 },
    "beta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "acknowledgement"],
      "properties": {
        "channel": { "const": "windows-x64-public-beta" },
        "acknowledgement": { "const": "--accept-public-beta" }
      }
    }
  },
  "$defs": {
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "root", "sha256", "size"],
      "properties": {
        "asset": { "type": "string", "pattern": "^[^/\\\\]+$" },
        "root": { "type": "string", "pattern": "^[^/\\\\]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 4294967296 }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installerAsset", "installer", "tools"],
      "properties": {
        "installerAsset": { "type": "string", "pattern": "^[^/\\\\]+$" },
        "installer": { "$ref": "#/$defs/file" },
        "tools": { "$ref": "#/$defs/archive" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "sha256", "size"],
      "properties": {
        "asset": { "type": "string", "pattern": "^[^/\\\\]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 4294967296 }
      }
    }
  },
  "oneOf": [
    {
      "not": { "required": ["beta"] },
      "properties": {
        "distributionMode": { "const": "release-ready" },
        "licenseStatus": { "const": "VERIFIED" },
        "platforms": { "required": ["darwin-arm64", "darwin-x64", "win32-x64"] }
      }
    },
    {
      "required": ["beta"],
      "properties": {
        "distributionMode": { "const": "public-beta" },
        "licenseStatus": { "const": "UNVERIFIED" },
        "platforms": {
          "required": ["win32-x64"],
          "maxProperties": 1
        }
      }
    },
    {
      "not": { "required": ["beta"] },
      "properties": {
        "distributionMode": { "const": "local-test-only" },
        "licenseStatus": { "const": "UNVERIFIED" }
      }
    }
  ]
}
